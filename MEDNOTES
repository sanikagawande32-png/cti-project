  const $ = id => document.getElementById(id);
  let currentLanguage = localStorage.getItem("mednotes-language") || "en";
  let currentUser = null;
  let currentProfile = null;

  function t(key) {
    return (translations[currentLanguage] && translations[currentLanguage][key]) ||
      translations.en[key] || key;
  }
  function translatePage(lang) {
    currentLanguage = translations[lang] ? lang : "en";
    localStorage.setItem("mednotes-language", currentLanguage);
    document.documentElement.lang = currentLanguage;
    document.querySelectorAll("[data-i18n]").forEach(el => {
      const key = el.dataset.i18n;
      if (t(key)) el.textContent = t(key);
    });
    document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
      el.placeholder = t(el.dataset.i18nPlaceholder);
    });
    $("languageSelect").value = currentLanguage;
    updateAuthSwitchText();
  }
  function message(text, type="notice") {
    const box = $("appMessage");
    box.className = text ? `notice ${type}` : "";
    box.textContent = text || "";
    if (text) window.scrollTo({top:0,behavior:"smooth"});
  }
  function showView(view) {
    ["homeView","authView","dashboardView"].forEach(id => $(id).classList.add("hidden"));
    $(view).classList.remove("hidden");
  }
  function showAuth(mode) {
    showView("authView");
    const signup = mode === "signup";
    $("signupForm").classList.toggle("hidden", !signup);
    $("loginForm").classList.toggle("hidden", signup);
    $("authTitle").textContent = t(signup ? "createAccount" : "login");
    $("authSwitchText").dataset.mode = signup ? "signup" : "login";
    updateAuthSwitchText();
    message("");
  }
  function updateAuthSwitchText() {
    const mode = $("authSwitchText").dataset.mode || "signup";
    $("authSwitchText").firstChild.textContent = mode === "signup" ? t("already") + " " : t("noAccount") + " ";
    $("switchToLogin").textContent = mode === "signup" ? t("login") : t("signup");
  }
  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
      "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
    }[c]));
  }
  function safeError(error) {
    console.error(error);
    return t("genericError");
  }

  $("languageSelect").addEventListener("change", e => translatePage(e.target.value));
  $("headerLoginBtn").addEventListener("click", () => showAuth("login"));
  $("headerSignupBtn").addEventListener("click", () => showAuth("signup"));
  $("heroLogin").addEventListener("click", () => showAuth("login"));
  $("heroGetStarted").addEventListener("click", () => showAuth("signup"));
  $("backHome").addEventListener("click", () => showView("homeView"));
  $("switchToLogin").addEventListener("click", () => showAuth($("authSwitchText").dataset.mode === "signup" ? "login" : "signup"));
  $("showUpload").addEventListener("click", () => $("uploadForm").classList.toggle("hidden"));

  $("signupForm").addEventListener("submit", async e => {
    e.preventDefault();
    message("");
    if (!supabase) return message(t("configMissing"), "error");
    const name = $("signupName").value.trim();
    const email = $("signupEmail").value.trim();
    const password = $("signupPassword").value;
    const confirm = $("signupConfirm").value;
    const birthDate = $("signupBirth").value || null;
    if (password !== confirm) return message(t("passwordMismatch"), "error");
    if (password.length < 12) return message(t("passwordLength"), "error");

    // The role selector is deliberately NOT used to grant permissions.
    // All new accounts begin as patient; admin must approve doctors in Supabase.
    const { error } = await supabase.auth.signUp({
      email, password,
      options: { data: { full_name: name, requested_role: $("signupRole").value, birth_date: birthDate } }
    });
    if (error) return message(safeError(error), "error");
    $("signupForm").reset();
    message(t("signupSuccess"), "success");
    showAuth("login");
  });

  $("loginForm").addEventListener("submit", async e => {
    e.preventDefault();
    message("");
    if (!supabase) return message(t("configMissing"), "error");
    const { error } = await supabase.auth.signInWithPassword({
      email: $("loginEmail").value.trim(),
      password: $("loginPassword").value
    });
    if (error) return message(t("genericError"), "error");
    await refreshSession();
  });

  $("forgotPassword").addEventListener("click", async () => {
    if (!supabase) return message(t("configMissing"), "error");
    const email = $("loginEmail").value.trim();
    if (!email) return message(t("forgotSent"));
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + window.location.pathname
    });
    if (error) return message(t("genericError"), "error");
    message(t("forgotSent"), "success");
  });

  $("logoutBtn").addEventListener("click", async () => {
    if (supabase) await supabase.auth.signOut();
    currentUser = null; currentProfile = null;
    $("logoutBtn").classList.add("hidden");
    $("headerLoginBtn").classList.remove("hidden");
    $("headerSignupBtn").classList.remove("hidden");
    showView("homeView");
    message(t("loggedOut"), "success");
  });

  async function refreshSession() {
    if (!supabase) return;
    const { data: { session }, error } = await supabase.auth.getSession();
    if (error || !session) {
      currentUser = null;
      $("logoutBtn").classList.add("hidden");
      showView("homeView");
      return;
    }
    currentUser = session.user;
    await loadDashboard();
  }

  async function loadDashboard() {
    if (!supabase || !currentUser) return;
    const { data: profile, error } = await supabase
      .from("patient_profiles")
      .select("user_id,full_name,birth_date,phone,role")
      .eq("user_id", currentUser.id)
      .maybeSingle();

    if (error) {
      message(t("profileLoadError"), "error");
      return;
    }
    currentProfile = profile;
    $("headerLoginBtn").classList.add("hidden");
    $("headerSignupBtn").classList.add("hidden");
    $("logoutBtn").classList.remove("hidden");
    $("welcomeUser").textContent = profile?.full_name || currentUser.email || "";
    $("roleBadge").textContent = profile?.role === "doctor" ? t("doctor") : t("patient");
    showView("dashboardView");
    $("patientDashboard").classList.toggle("hidden", profile?.role === "doctor");
    $("doctorDashboard").classList.toggle("hidden", profile?.role !== "doctor");

    if (profile?.role === "doctor") {
      await loadDoctorPatients();
    } else {
      $("profileName").value = profile?.full_name || currentUser.user_metadata?.full_name || "";
      $("profileBirth").value = profile?.birth_date || currentUser.user_metadata?.birth_date || "";
      $("profilePhone").value = profile?.phone || "";
      await loadNotes();
    }
    message("");
  }

  $("profileForm").addEventListener("submit", async e => {
    e.preventDefault();
    if (!supabase || !currentUser) return;
    const update = {
      user_id: currentUser.id,
      full_name: $("profileName").value.trim(),
      birth_date: $("profileBirth").value || null,
      phone: $("profilePhone").value.trim() || null
    };
    const { error } = await supabase.from("patient_profiles").upsert(update, { onConflict:"user_id" });
    if (error) return message(safeError(error), "error");
    message(t("profileSaved"), "success");
    $("welcomeUser").textContent = update.full_name;
  });

  $("noteForm").addEventListener("submit", async e => {
    e.preventDefault();
    if (!supabase || !currentUser) return;
    const title = $("noteTitle").value.trim();
    const body = $("noteText").value.trim();
    const { error } = await supabase.from("medical_notes").insert({
      patient_id: currentUser.id, title, body
    });
    if (error) return message(safeError(error), "error");
    $("noteForm").reset();
    message(t("noteSaved"), "success");
    await loadNotes();
  });

  async function loadNotes() {
    if (!supabase || !currentUser) return;
    const { data, error } = await supabase.from("medical_notes")
      .select("id,title,body,created_at")
      .eq("patient_id", currentUser.id)
      .order("created_at", { ascending:false });
    if (error) {
      $("notesList").textContent = t("noteLoadError");
      return;
    }
    const list = $("notesList");
    list.replaceChildren();
    if (!data?.length) {
      list.textContent = t("noNotes");
      return;
    }
    data.forEach(note => {
      const item = document.createElement("article");
      item.className = "record";
      const h = document.createElement("h3");
      h.textContent = note.title;
      const p = document.createElement("p");
      p.textContent = note.body;
      const small = document.createElement("p");
      small.className = "small muted";
      small.textContent = new Date(note.created_at).toLocaleString();
      const del = document.createElement("button");
      del.className = "danger";
      del.textContent = t("deleteNote");
      del.addEventListener("click", async () => {
        const { error: deleteError } = await supabase.from("medical_notes").delete().eq("id", note.id);
        if (deleteError) return message(safeError(deleteError), "error");
        message(t("noteDeleted"), "success");
        await loadNotes();
      });
      item.append(h,p,small,del);
      list.append(item);
    });
  }

  async function loadDoctorPatients() {
    if (!supabase || !currentUser || currentProfile?.role !== "doctor") {
      $("doctorPatientsList").textContent = t("notDoctor");
      return;
    }
    // RLS only returns patients for whom this doctor has an approved access link.
    const { data, error } = await supabase.from("doctor_patient_access")
      .select("patient_id,patient_profiles!doctor_patient_access_patient_id_fkey(user_id,full_name,birth_date)")
      .eq("doctor_id", currentUser.id)
      .eq("approved", true);
    const list = $("doctorPatientsList");
    list.replaceChildren();
    if (error) {
      list.textContent = t("noPatients");
      console.error(error);
      return;
    }
    if (!data?.length) {
      list.textContent = t("noPatients");
      return;
    }
    data.forEach(row => {
      const p = row.patient_profiles;
      const item = document.createElement("article");
      item.className = "record";
      const title = document.createElement("h3");
      title.textContent = p?.full_name || t("patient");
      const id = document.createElement("p");
      id.className = "small muted";
      id.textContent = `${t("patientId")}: ${row.patient_id}`;
      item.append(title,id);
      list.append(item);
    });
  }

  $("loadDoctorPatients").addEventListener("click", loadDoctorPatients);
  $("refreshDashboard").addEventListener("click", refreshSession);
  $("uploadForm").addEventListener("submit", e => {
    e.preventDefault();
    message(t("reportNotReady"), "error");
  });

  translatePage(currentLanguage);
  if (supabase) {
    supabase.auth.onAuthStateChange((_event, _session) => {
      // Defer async work out of the auth callback to avoid blocking auth events.
      setTimeout(() => refreshSession(), 0);
    });
    refreshSession();
  } else {
    $("authNote").textContent = t("configMissing");
  }
</script>
</body>
</html>
'''

sql = r'''-- MedNotes starter schema for Supabase.
-- Run this in Supabase > SQL Editor, after creating your project.
-- Test with dummy accounts only. Review security policies before real use.

create extension if not exists pgcrypto;

-- Profiles: role defaults to patient. Users must NOT be allowed to update their own role.
create table if not exists public.patient_profiles (
  user_id uuid primary key references auth.users(id) on delete cascade,
  full_name text not null default 'Patient',
  birth_date date,
  phone text,
  role text not null default 'patient' check (role in ('patient','doctor','admin')),
  created_at timestamptz not null default now()
);

alter table public.patient_profiles enable row level security;

drop policy if exists "Users read own profile" on public.patient_profiles;
create policy "Users read own profile"
on public.patient_profiles for select to authenticated
using ((select auth.uid()) = user_id);

drop policy if exists "Users insert own patient profile" on public.patient_profiles;
create policy "Users insert own patient profile"
on public.patient_profiles for insert to authenticated
with check ((select auth.uid()) = user_id and role = 'patient');

drop policy if exists "Users update own profile but not role" on public.patient_profiles;
create policy "Users update own profile but not role"
on public.patient_profiles for update to authenticated
using ((select auth.uid()) = user_id)
with check ((select auth.uid()) = user_id and role = 'patient');

-- Create profile automatically. Do not trust user metadata to grant doctor/admin role.
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
  insert into public.patient_profiles (user_id, full_name, birth_date, role)
  values (
    new.id,
    coalesce(new.raw_user_meta_data ->> 'full_name', 'Patient'),
    nullif(new.raw_user_meta_data ->> 'birth_date', '')::date,
    'patient'
  )
  on conflict (user_id) do nothing;
  return new;
end;
$$;

drop trigger if exists on_auth_user_created_mednotes on auth.users;
create trigger on_auth_user_created_mednotes
after insert on auth.users
for each row execute function public.handle_new_user();

-- Notes belong to a patient. Patients can only read/write their own notes.
create table if not exists public.medical_notes (
  id uuid primary key default gen_random_uuid(),
  patient_id uuid not null references auth.users(id) on delete cascade,
  title text not null check (char_length(title) between 1 and 120),
  body text not null check (char_length(body) between 1 and 5000),
  created_at timestamptz not null default now()
);

alter table public.medical_notes enable row level security;

drop policy if exists "Patients read own notes" on public.medical_notes;
create policy "Patients read own notes"
on public.medical_notes for select to authenticated
using ((select auth.uid()) = patient_id);

drop policy if exists "Patients create own notes" on public.medical_notes;
create policy "Patients create own notes"
on public.medical_notes for insert to authenticated
with check ((select auth.uid()) = patient_id);

drop policy if exists "Patients delete own notes" on public.medical_notes;
create policy "Patients delete own notes"
on public.medical_notes for delete to authenticated
using ((select auth.uid()) = patient_id);

-- Doctors only see patients with an explicit, approved access link.
create table if not exists public.doctor_patient_access (
  doctor_id uuid not null references auth.users(id) on delete cascade,
  patient_id uuid not null references auth.users(id) on delete cascade,
  approved boolean not null default false,
  created_at timestamptz not null default now(),
  primary key (doctor_id, patient_id),
  constraint different_doctor_patient check (doctor_id <> patient_id)
);

alter table public.doctor_patient_access enable row level security;

-- Both sides can see their own link; only trusted admins should approve links.
drop policy if exists "Participants can view own access links" on public.doctor_patient_access;
create policy "Participants can view own access links"
on public.doctor_patient_access for select to authenticated
using ((select auth.uid()) = doctor_id or (select auth.uid()) = patient_id);

-- Do not provide insert/update/delete policies to public users here.
-- Add a trusted approval workflow (e.g. reviewed admin process or server-side function)
-- before creating access links or changing approved to true.

-- Allow approved doctors to read the linked patient's profile.
drop policy if exists "Approved doctors read linked patient profiles" on public.patient_profiles;
create policy "Approved doctors read linked patient profiles"
on public.patient_profiles for select to authenticated
using (
  exists (
    select 1
    from public.doctor_patient_access a
    join public.patient_profiles doctor_profile on doctor_profile.user_id = a.doctor_id
    where a.patient_id = patient_profiles.user_id
      and a.doctor_id = (select auth.uid())
      and a.approved = true
      and doctor_profile.role = 'doctor'
  )
);

-- Allow approved doctors to read notes for patients linked to them.
drop policy if exists "Approved doctors read linked patient notes" on public.medical_notes;
create policy "Approved doctors read linked patient notes"
on public.medical_notes for select to authenticated
using (
  exists (
    select 1
    from public.doctor_patient_access a
    join public.patient_profiles doctor_profile on doctor_profile.user_id = a.doctor_id
    where a.patient_id = medical_notes.patient_id
      and a.doctor_id = (select auth.uid())
      and a.approved = true
      and doctor_profile.role = 'doctor'
  )
);

-- IMPORTANT: an administrator must approve doctor accounts through a trusted process.
-- Never let a public signup form set role='doctor' or role='admin'.
-- Configure a private Storage bucket named "medical-reports" separately.
-- Storage access policies must check auth.uid() against the patient folder / access links.
'''

readme = r'''# MedNotes secure starter (GitHub Pages + Supabase)

## Files
- `index.html`: responsive bilingual/multilingual patient + doctor dashboard frontend.
